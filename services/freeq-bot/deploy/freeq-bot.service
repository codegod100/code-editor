# /etc/systemd/system/freeq-bot.service
[Unit]
Description=freeq bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=freeq
WorkingDirectory=/opt/freeq-bot
EnvironmentFile=/etc/freeq-bot.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5s
# The bot's did:key seed lives here; losing it means losing the identity.
StateDirectory=freeq-bot
Environment=FREEQ_STATE_DIR=/var/lib/freeq-bot

# It makes one outbound WebSocket and writes one directory. Nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
