# Required — the AT Protocol DID this bot acts on behalf of.
FREEQ_OWNER_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx

# The dedicated worker's FreeQ connection and one accepted offer capability.
FREEQ_NICK=freeq-bot
FREEQ_SERVER=wss://irc.freeq.at/irc
FREEQ_CHANNELS=#tasks
FREEQ_CAPABILITY=prime_agent
FREEQ_STATE_DIR=/var/lib/freeq-bot

# The required Modal task runner. The Modal SDK reads MODAL_TOKEN_ID and
# MODAL_TOKEN_SECRET from the environment; do not put them in this file.
MODAL_APP=prime-agent
MODAL_FUNCTION=run_task
TASK_TIMEOUT_MS=1200000
MAX_CONCURRENT_TASKS=3
PROOF_BASE_URL=https://codegod100--prime-agent-proof.modal.run

# Optional — path to the owner's ed25519 seed. When set, the delegation cert is
# signed by the owner and the server reports the bot as verified.
# FREEQ_CREATOR_KEY=/var/lib/freeq-bot/owner.key
